# Server Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# NTTH API Configuration
NTTH_API_BASE_URL=https://api.ntth.ai/v1
NTTH_APP_ID=your-ntth-application-id-here
NTTH_APP_SECRET=your-ntth-application-secret-here
NTTH_TOKEN_REFRESH_MARGIN_MINUTES=60

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ntth_gateway
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ntth_gateway
DB_USER=user
DB_PASSWORD=password
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# API Gateway Configuration
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=24h
API_TOKEN_PREFIX=sk-ntth-

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ENABLED=true

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# CORS Configuration
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# Cache Configuration
CACHE_TTL_SECONDS=300
CACHE_ENABLED=true
